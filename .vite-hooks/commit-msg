#!/usr/bin/env sh

# Read the commit message Git created and keep the first line as the header.
commit_message=$(cat "$1")
header=$(printf '%s\n' "$commit_message" | head -n 1)

# Conventional Commit header format:
#
#   type(scope)!: description
#
# Scope and the breaking-change marker (!) are optional.
pattern='^(feat|fix|build|chore|ci|docs|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+'

# ─────────────────────────────────────────────
# Validate the commit header
# ─────────────────────────────────────────────

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  echo ""
  echo "❌ Invalid commit message."
  echo ""
  echo "Expected:"
  echo "  type(scope): description"
  echo ""
  echo "Examples:"
  echo "  feat: add login"
  echo "  feat(auth): add login"
  echo "  fix(api): handle timeout"
  echo "  feat(api)!: change response format"
  echo ""
  exit 1
fi

# A commit containing only a valid header is allowed.
if [ "$(printf '%s\n' "$commit_message" | wc -l)" -eq 1 ]; then
  exit 0
fi

# ─────────────────────────────────────────────
# Validate the commit body and footers
# ─────────────────────────────────────────────
#
# The commit body is intentionally free-form.
# Once a valid footer is encountered, every following
# non-empty line must also use valid footer syntax.

footer_started=false

while IFS= read -r line; do

  # The first line is the commit header, which was already validated above.
  [ "$line" = "$header" ] && continue

  # Blank lines are allowed between the header, body, and footer sections.
  if [ -z "$line" ]; then
    continue
  fi

  # A valid footer can use either:
  #
  #   Token: value
  #   Token #value
  #
  # "BREAKING CHANGE" and "BREAKING-CHANGE" are special
  # Conventional Commit footer tokens.
  if printf '%s\n' "$line" | grep -Eq \
    '^(BREAKING CHANGE|BREAKING-CHANGE|[A-Za-z0-9-]+): .+'; then
    footer_started=true
    continue
  fi

  if printf '%s\n' "$line" | grep -Eq \
    '^[A-Za-z0-9-]+ #[^[:space:]].*'; then
    footer_started=true
    continue
  fi

  # After the footer section starts, every non-empty line
  # must be another valid footer.
  if [ "$footer_started" = true ]; then
    echo ""
    echo "❌ Invalid commit footer."
    echo ""
    echo "Expected:"
    echo "  Token: value"
    echo "  Token #value"
    echo ""
    echo "Examples:"
    echo "  BREAKING CHANGE: API response changed"
    echo "  Reviewed-by: Mangesh"
    echo "  Refs: #123"
    echo ""
    exit 1
  fi

done <<EOF
$commit_message
EOF

# All commit message sections passed validation.
exit 0
